using System;
using System.Linq;

namespace Names
{
    internal static class HeatmapTask
    {
        public static HeatmapData GetBirthsPerDateHeatmap(NameData[] names)
        {
            // Защита от null
            names ??= Array.Empty<NameData>();

            // Дни: "2".."31" (30 элементов), месяцы: "1".."12"
            string[] days = Enumerable.Range(2, 30).Select(d => d.ToString()).ToArray();
            string[] months = Enumerable.Range(1, 12).Select(m => m.ToString()).ToArray();

            var heat = new double[30, 12];

            foreach (var name in names)
            {
                var bd = name?.BirthDate ?? default;
                int day = bd.Day;
                int month = bd.Month;

                // Игнорируем 1-е число и некорректные даты вне ожидаемого диапазона
                if (day <= 1 || day > 31 || month < 1 || month > 12) 
                    continue;

                heat[day - 2, month - 1]++;
            }

            return new HeatmapData("Пример карты интенсивностей", heat, days, months);
        }
    }
}
