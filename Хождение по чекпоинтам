using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;

namespace RoutePlanning;

public static class PathFinderTask
{
    private static double _minimalLength;

    public static int[] FindBestCheckpointsOrder(Point[] checkpoints)
    {
        _minimalLength = double.MaxValue;
        var array = Enumerable.Range(0, checkpoints.Length).ToArray();
        return MakeTrivialPermutation(checkpoints, array, 1, array, new double[checkpoints.Length]);
    }

    private static int[] MakeTrivialPermutation(Point[] checkpoints, int[] permutation, int position,
        int[] best, IList<double> lengths)
    {
        {
            if (lengths[^1] < _minimalLength && position == permutation.Length)
            {
                best = (int[])permutation.Clone();
                _minimalLength = lengths[^1];
                return best;
            }

            for (var i = 1; i < permutation.Length; i++)
            {
                if (Array.IndexOf(permutation, i, 1, position - 1) != -1) continue;
                lengths[position] = lengths[position - 1] +
                                    checkpoints[permutation[position - 1]].DistanceTo(checkpoints[i]);

                if (!(lengths[position] < _minimalLength)) continue;
                permutation[position] = i;
                best = MakeTrivialPermutation(checkpoints, permutation, position + 1, best, lengths);
            }

            return best;
        }
    }
}

