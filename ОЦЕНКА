using System;

class Program
{
    static void Main()
    {
        Console.Write("Введите балл: ");
        
        // Использование TryParse избегает исключений при некорректном вводе
        if (!int.TryParse(Console.ReadLine(), out int score))
        {
            Console.WriteLine("Некорректный ввод");
            return;
        }

        // Упрощенная логика без избыточных проверок
        // Проверки выполняются последовательно, исключая ненужные условия
        if (score > 100 || score < 0)
            Console.WriteLine("Некорректный балл");
        else if (score >= 90)
            Console.WriteLine("Оценка: Отлично");
        else if (score >= 75)
            Console.WriteLine("Оценка: Хорошо");
        else if (score >= 50)
            Console.WriteLine("Оценка: Удовлетворительно");
        else
            Console.WriteLine("Оценка: Неудовлетворительно");
    }
}
